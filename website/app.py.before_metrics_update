
from pathlib import Path
import math
import re

from flask import Flask, jsonify, render_template, request
from pyspark.sql import SparkSession, functions as F
from pyspark.ml import PipelineModel

# --------------------------------------------------
# Paths
# --------------------------------------------------
BASE_DIR = Path(__file__).resolve().parent.parent
OUTPUT_DIR = BASE_DIR / "output"
EVIDENCE_DIR = BASE_DIR / "review_evidence"

MODEL_PATH = OUTPUT_DIR / "enhanced_purchase_model"
METRICS_PATH = OUTPUT_DIR / "enhanced_purchase_model_metrics.txt"
THRESHOLD_PATH = OUTPUT_DIR / "enhanced_purchase_threshold.txt"
COMPARISON_PATH = EVIDENCE_DIR / "enhanced_model_comparison.txt"

app = Flask(__name__)

# --------------------------------------------------
# Spark and saved model
# --------------------------------------------------
spark = (
    SparkSession.builder
    .appName("RetailIQPurchaseWebsite")
    .master("local[*]")
    .config("spark.sql.shuffle.partitions", "4")
    .getOrCreate()
)
spark.sparkContext.setLogLevel("ERROR")

model = PipelineModel.load(MODEL_PATH.resolve().as_uri())


# --------------------------------------------------
# Read metrics generated by the training script
# --------------------------------------------------
def parse_result_line(line):
    """Parse one result line written by compare_enhanced_models.py."""
    pattern = (
        r"^(.*?)\s*\|\s*threshold=([0-9.]+)"
        r"\s*\|\s*accuracy=([0-9.]+)"
        r"\s*\|\s*precision=([0-9.]+)"
        r"\s*\|\s*recall=([0-9.]+)"
        r"\s*\|\s*F1=([0-9.]+)"
        r"\s*\|\s*PR-AUC=([0-9.]+)"
        r"\s*\|\s*TP=(\d+)\s+FP=(\d+)\s+TN=(\d+)\s+FN=(\d+)"
    )

    match = re.search(pattern, line.strip())
    if not match:
        return None

    name, threshold, accuracy, precision, recall, f1, pr_auc, tp, fp, tn, fn = (
        match.groups()
    )

    return {
        "name": name,
        "threshold": float(threshold),
        "accuracy": float(accuracy),
        "precision": float(precision),
        "recall": float(recall),
        "f1": float(f1),
        "pr_auc": float(pr_auc),
        "tp": int(tp),
        "fp": int(fp),
        "tn": int(tn),
        "fn": int(fn),
    }


def read_model_results():
    """Read the latest model comparison results from the training run."""
    results = []

    if COMPARISON_PATH.exists():
        for line in COMPARISON_PATH.read_text().splitlines():
            parsed = parse_result_line(line)
            if parsed:
                results.append(parsed)

    return results


def read_dashboard_metrics():
    """
    Read the saved Logistic Regression test metrics and threshold.
    No old metric values are hardcoded here.
    """
    metrics = None

    if METRICS_PATH.exists():
        for line in METRICS_PATH.read_text().splitlines():
            parsed = parse_result_line(line)
            if parsed:
                metrics = parsed
                break

    # Fall back to the comparison file if the individual metrics file
    # is missing or empty.
    if metrics is None:
        results = read_model_results()
        metrics = next(
            (
                result for result in results
                if result["name"] == "Enhanced Logistic Regression"
            ),
            None,
        )

    # Read the current threshold file if it exists.
    if THRESHOLD_PATH.exists():
        try:
            saved_threshold = float(THRESHOLD_PATH.read_text().strip())
            if math.isfinite(saved_threshold) and 0 <= saved_threshold <= 1:
                if metrics is None:
                    metrics = {}
                metrics["threshold"] = saved_threshold
        except (ValueError, OSError):
            app.logger.warning("Could not read saved threshold file.")

    if metrics is None:
        return {
            "available": False,
            "message": (
                "Metrics are not available yet. Run "
                "python python/compare_enhanced_models.py first."
            ),
        }

    metrics["available"] = True
    return metrics


# --------------------------------------------------
# Pages and API endpoints
# --------------------------------------------------
@app.route("/")
def index():
    metrics = read_dashboard_metrics()
    model_results = read_model_results()

    return render_template(
        "index.html",
        metrics=metrics,
        model_results=model_results,
    )


@app.route("/api/health")
def health():
    return jsonify({
        "status": "ok",
        "model_loaded": model is not None,
    })


@app.route("/api/metrics")
def metrics_api():
    """Return the latest metrics and comparison results as JSON."""
    return jsonify({
        "metrics": read_dashboard_metrics(),
        "models": read_model_results(),
    })


# --------------------------------------------------
# Live prediction endpoint
# --------------------------------------------------
@app.route("/api/predict", methods=["POST"])
def predict():
    payload = request.get_json(silent=True) or {}

    integer_fields = [
        "views",
        "carts",
        "total_events",
        "unique_items",
        "unique_viewed",
        "unique_carted",
    ]
    numeric_fields = [
        "days_active",
        "hours_since_activity",
    ]

    try:
        values = {}

        for field in integer_fields:
            number = float(payload[field])

            if (
                not math.isfinite(number)
                or not number.is_integer()
                or number < 0
            ):
                raise ValueError(
                    f"{field} must be a non-negative integer"
                )

            values[field] = int(number)

        for field in numeric_fields:
            number = float(payload[field])

            if not math.isfinite(number) or number < 0:
                raise ValueError(f"{field} must be non-negative")

            values[field] = number

    except (KeyError, TypeError, ValueError) as exc:
        return jsonify({"error": f"Invalid input: {exc}"}), 400

    # Validate the supplied visitor counts.
    if values["total_events"] < values["views"] + values["carts"]:
        return jsonify({
            "error": (
                "Total events must be at least views plus cart events."
            )
        }), 400

    if values["unique_items"] > values["total_events"]:
        return jsonify({
            "error": "Unique items cannot exceed total events."
        }), 400

    if values["unique_viewed"] > values["views"]:
        return jsonify({
            "error": "Unique viewed items cannot exceed view events."
        }), 400

    if values["unique_carted"] > values["carts"]:
        return jsonify({
            "error": "Unique carted items cannot exceed cart events."
        }), 400

    # IMPORTANT: Feature names and calculations must match the
    # training script exactly. The new pipeline has 11 features.
    row = {
        "log_views": math.log1p(values["views"]),
        "log_carts": math.log1p(values["carts"]),
        "log_total": math.log1p(values["total_events"]),
        "log_unique_items": math.log1p(values["unique_items"]),
        "log_unique_viewed": math.log1p(values["unique_viewed"]),
        "log_unique_carted": math.log1p(values["unique_carted"]),
        "log_days_active": math.log1p(values["days_active"]),
        "log_recency": math.log1p(values["hours_since_activity"]),
        "has_cart": 1.0 if values["carts"] > 0 else 0.0,
        "cart_view_ratio": (
            values["carts"] / (values["views"] + 1.0)
        ),
        "events_per_active_day": (
            values["total_events"] / (values["days_active"] + 1.0)
        ),
    }

    try:
        prediction_row = model.transform(
            spark.createDataFrame([row])
        ).first()

        score = float(prediction_row["probability"][1])

        metrics = read_dashboard_metrics()
        if not metrics.get("available"):
            return jsonify({
                "error": "Model evaluation metrics are unavailable."
            }), 503

        threshold = float(metrics["threshold"])
        predicted_buyer = score >= threshold

        return jsonify({
            "score": score,
            "score_percent": round(score * 100, 2),
            "threshold": threshold,
            "prediction": int(predicted_buyer),
            "prediction_label": (
                "Higher purchase likelihood"
                if predicted_buyer
                else "Lower purchase likelihood"
            ),
            "note": (
                "This is an uncalibrated model score, not a guaranteed "
                "real-world purchase probability."
            ),
        })

    except Exception:
        app.logger.exception("Prediction failed")
        return jsonify({
            "error": (
                "Prediction failed. Check the Flask terminal for details."
            )
        }), 500


# --------------------------------------------------
# Dataset statistics API
# --------------------------------------------------
_dataset_stats_cache = None

@app.route("/api/dataset", methods=["GET"])
def dataset_stats():
    global _dataset_stats_cache

    if _dataset_stats_cache is not None:
        return jsonify(_dataset_stats_cache)

    try:
        dataset_path = (BASE_DIR / "data" / "events.csv").resolve()

        if not dataset_path.is_file():
            return jsonify({"error": "Dataset file not found."}), 404

        events_df = (
            spark.read
            .option("header", "true")
            .option("inferSchema", "false")
            .csv(dataset_path.as_uri())
        )

        required_columns = {
            "timestamp", "visitorid", "event", "itemid", "transactionid"
        }
        if not required_columns.issubset(set(events_df.columns)):
            return jsonify({
                "error": "Dataset columns do not match the expected schema."
            }), 500

        total_events = events_df.count()
        unique_visitors = events_df.select("visitorid").distinct().count()

        event_counts = {
            row["event"]: row["count"]
            for row in events_df.groupBy("event").count().collect()
        }

        _dataset_stats_cache = {
            "file": "data/events.csv",
            "file_size_mb": round(dataset_path.stat().st_size / (1024 * 1024), 2),
            "total_events": total_events,
            "unique_visitors": unique_visitors,
            "columns": events_df.columns,
            "event_counts": event_counts,
            "status": "success"
        }

        return jsonify(_dataset_stats_cache)

    except Exception:
        app.logger.exception("Dataset statistics failed")
        return jsonify({
            "error": "Could not calculate dataset statistics. Check the Flask terminal."
        }), 500


# --------------------------------------------------
# Next-Best-Product API
# --------------------------------------------------
_products_cache = None

@app.route("/api/products", methods=["GET"])
def product_recommendations():
    global _products_cache

    if _products_cache is not None:
        return jsonify(_products_cache)

    try:
        dataset_path = (BASE_DIR / "data" / "events.csv").resolve()

        if not dataset_path.is_file():
            return jsonify({"error": "Dataset file not found."}), 404

        events_df = (
            spark.read
            .option("header", "true")
            .option("inferSchema", "false")
            .csv(dataset_path.as_uri())
        )

        products_df = (
            events_df
            .filter(
                F.col("itemid").isNotNull()
                & F.col("event").isin(
                    "view", "addtocart", "transaction"
                )
            )
            .groupBy("itemid")
            .agg(
                F.count("*").alias("interactions")
            )
            .orderBy(
                F.desc("interactions"),
                F.asc("itemid")
            )
            .limit(3)
            .collect()
        )

        if not products_df:
            return jsonify({"products": [], "status": "success"})

        max_interactions = max(row["interactions"] for row in products_df)

        _products_cache = {
            "status": "success",
            "method": "Popularity baseline",
            "products": [
                {
                    "itemid": str(row["itemid"]),
                    "interactions": int(row["interactions"]),
                    "relevance_score": round(
                        row["interactions"] / max_interactions * 100, 2
                    )
                }
                for row in products_df
            ],
            "note": (
                "Relevance scores are normalized interaction counts, "
                "not purchase probabilities or personalized recommendations."
            )
        }

        return jsonify(_products_cache)

    except Exception:
        app.logger.exception("Product recommendations failed")
        return jsonify({
            "error": "Could not calculate product recommendations."
        }), 500


if __name__ == "__main__":
    app.run(
        host="127.0.0.1",
        port=5000,
        debug=False,
    )
